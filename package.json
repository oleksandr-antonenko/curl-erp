{
  "name": "@curl-erp/core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "BUSL-1.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tenancy": "./dist/tenancy/index.js",
    "./change-feed": "./dist/change-feed/index.js",
    "./auth": "./dist/auth/index.js",
    "./channels": "./dist/channels/index.js",
    "./testing": "./dist/testing/index.js",
    "./runtime": "./dist/tenancy/runtime.js",
    "./catalog": "./dist/catalog/index.js",
    "./catalog-import": "./dist/catalog-import/index.js",
    "./pricing": "./dist/pricing/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "lint": "biome check . && npm run check:vendor",
    "check:vendor": "tsx scripts/check-vendor-neutrality.ts",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "prepare": "tsc --build"
  },
  "bin": {
    "erp-tenant": "./dist/cli/tenant.js"
  },
  "description": "System of record for a small commerce business: catalog, stock, money, counterparties and documents.",
  "keywords": [
    "erp",
    "commerce",
    "multi-tenant",
    "postgresql",
    "accounting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleksandr-antonenko/curl-erp.git"
  },
  "files": [
    "dist",
    "drizzle",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
